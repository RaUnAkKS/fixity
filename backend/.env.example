# ==============================================================================
# CivicAI Backend Environment Variables (.env.example)
# ==============================================================================
# Copy this file to .env for local development: cp .env.example .env
# For Render deployment, add these variables in Render Service Settings > Environment.
# DO NOT commit real secrets (.env) to version control.
# ==============================================================================

# Database Connection (Neon, Render PostgreSQL, Supabase, or AWS RDS)
# asyncpg connection string used by FastAPI application
DATABASE_URL=postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>?ssl=require
# Synchronous connection string (optional, for sync tools / Alembic)
DATABASE_URL_SYNC=postgresql://<username>:<password>@<host>:<port>/<database>?ssl=require

# Authentication & Security
# Generate a strong 32+ character random string (e.g., `openssl rand -hex 32`)
JWT_SECRET_KEY=your-production-jwt-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# AI Provider Keys
# Google Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
# Groq API key from https://console.groq.com/keys (for Whisper STT & fast inference)
GROQ_API_KEY=your-groq-api-key

# AI Embeddings Provider ('local' or 'gemini')
EMBEDDING_PROVIDER=local

# File Storage Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# Geocoding Service Settings
NOMINATIM_USER_AGENT=civicai-production-app

# Frontend CORS Origin URL (Production Vercel URL, e.g. https://my-civicai.vercel.app)
# Comma-separated if multiple domains are needed
FRONTEND_URL=https://your-frontend-domain.vercel.app
